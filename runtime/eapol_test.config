# eapol_test needs no wireless driver, raw socket, or network administration.
CONFIG_DRIVER_NONE=y
CONFIG_EAPOL_TEST=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_BACKEND=file
CONFIG_CTRL_IFACE=y
CONFIG_IPV6=y
CONFIG_TLS=openssl
CONFIG_EAP_TLS=y
CONFIG_EAP_TLSV1_3=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
