+static int eapol_test_add_extra_spec(struct eapol_test_data *e,
+                                   struct extra_radius_attr **tail, char *spec)
+{
+	struct extra_radius_attr *attr;
+	char *pos;
+
+	attr = os_zalloc(sizeof(*attr));
+	if (!attr)
+		return -1;
+	if (!*tail)
+		e->extra_attrs = attr;
+	else
+		(*tail)->next = attr;
+	*tail = attr;
+
+	attr->type = atoi(spec);
+	pos = os_strchr(spec, ':');
+	if (!pos) {
+		attr->syntax = 'n';
+		return 0;
+	}
+	pos++;
+	if (pos[0] == '\0' || pos[1] != ':') {
+		printf("Incorrect format of attribute specification\n");
+		return -1;
+	}
+	attr->syntax = pos[0];
+	attr->data = pos + 2;
+	return 0;
+}
