+	eapol_test_file_attrs = eapol_test_read_file(
+		path, 0, EAPOL_TEST_ATTR_FILE_MAX);
+	if (!eapol_test_file_attrs)
+		return -1;
+	line = eapol_test_file_attrs;
+	while (*line) {
+		end = os_strchr(line, '\n');
+		len = end ? (size_t) (end - line) : os_strlen(line);
+		if (++rows > EAPOL_TEST_ATTR_COUNT_MAX ||
+		    len > EAPOL_TEST_ATTR_LINE_MAX)
+			return -1;
+		if (end)
+			*end = '\0';
+		pos = line;
+		type = 0;
+		digits = 0;
+		while (*pos >= '0' && *pos <= '9') {
+			if (++digits > 3)
+				return -1;
+			type = type * 10 + *pos++ - '0';
+		}
+		if (!digits || type < 1 || type > 255 ||
+		    os_strncmp(pos, ":x:", 3) != 0)
+			return -1;
+		pos += 3;
+		len = os_strlen(pos);
+		if ((len & 1) || len > 2 * RADIUS_MAX_ATTR_LEN)
+			return -1;
+		for (i = 0; i < len; i++) {
