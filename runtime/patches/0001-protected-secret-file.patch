 static struct eapol_test_data eapol_test;
+
+#define EAPOL_TEST_SECRET_MAX 4096
+static char *eapol_test_file_secret;
+
+
+/* Clear both the file input and the RADIUS client's owned copy on normal exit. */
+static void eapol_test_clear_secrets(void)
+{
+	struct hostapd_radius_server *as;
+
+	bin_clear_free(eapol_test_file_secret, EAPOL_TEST_SECRET_MAX + 1);
+	eapol_test_file_secret = NULL;
+	if (!eapol_test.radius_conf || !eapol_test.radius_conf->auth_server)
+		return;
+	as = eapol_test.radius_conf->auth_server;
+	bin_clear_free(as->shared_secret, as->shared_secret_len + 1);
+	as->shared_secret = NULL;
+	as->shared_secret_len = 0;
+}
+
+
+/* Linux file input: exact bytes, no newline stripping, and no value in errors. */
+static char * eapol_test_read_secret(const char *path)
+{
+	struct stat st;
+	char *buf = NULL;
+	size_t len = 0;
+	ssize_t n;
+	int fd;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+	if (fd < 0)
+		return NULL;
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode) ||
+	    st.st_uid != geteuid() || st.st_nlink != 1 ||
+	    ((st.st_mode & 07777) != 0400 &&
+	     (st.st_mode & 07777) != 0600) ||
+	    st.st_size < 1 || st.st_size > EAPOL_TEST_SECRET_MAX)
+		goto fail;
+	buf = os_zalloc(EAPOL_TEST_SECRET_MAX + 1);
+	if (!buf)
+		goto fail;
+	while (len < EAPOL_TEST_SECRET_MAX + 1) {
+		n = read(fd, buf + len, EAPOL_TEST_SECRET_MAX + 1 - len);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n < 0)
+			goto fail;
+		if (n == 0)
+			break;
+		len += n;
+	}
+	if (len < 1 || len > EAPOL_TEST_SECRET_MAX ||
+	    (off_t) len != st.st_size || memchr(buf, '\0', len))
+		goto fail;
+	close(fd);
+	return buf;
+
+fail:
+	close(fd);
+	bin_clear_free(buf, EAPOL_TEST_SECRET_MAX + 1);
+	return NULL;
+}
 
 
